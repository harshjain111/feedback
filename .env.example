# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never import into a client component.
# Bypasses Row Level Security — see CLAUDE.md §7.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# The outlet this deployment serves. Every query is scoped by it (CLAUDE.md §43).
NEXT_PUBLIC_OUTLET_CODE=AIC
