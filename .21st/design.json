  "constraints": {
    "must": [
      "Read CLAUDE.md before changing any surface; §5 copy and §6 kiosk geometry are locked.",
      "Take every customer-facing string from app_config via getConfig() (§3). A literal is a bug.",
      "Use the existing colour/type/radius tokens in app/globals.css; add a token rather than an arbitrary value.",
      "Keep both layouts when touching a data view: mobile cards and the wide grid.",
      "Preserve loading, empty and error states — each route has a skeleton shaped like the page.",
      "Keyboard focus must stay visible; the global :focus-visible ring is in app/globals.css."
    ],
    "avoid": [
      "Restyling the kiosk: §6 fixes portrait 1080x1920, --kpx sizing and 88px tap targets.",
      "Editing locked kiosk copy anywhere but the CMS (§14.4).",
      "Adding a UI library or parallel primitives — this project has no components/ui and does not want one.",
      "Decorative gradients, glass, shadows. The visual language is paper on paper separated by hairlines.",
      "Tables with a min-width on mobile; they push the document wider than the viewport."
    ]
  },
  "decisions": [
    {
      "date": "2026-09-14",
      "choice": "Global :focus-visible ring in currentColor, 2px solid at 2px offset.",
      "why": "Custom rows and icon buttons had no visible keyboard focus at all. currentColor adapts to context by itself — white on the dark sidebar, ink on the cream canvas — so it needs no per-surface override. An accent-green ring required one, because green on the #10261c sidebar is close to invisible.",
      "files": [
        "app/globals.css"
      ]
    },
    {
      "date": "2026-09-14",
      "choice": "Titles use a \"%s · All India Café\" template, each admin page supplying its own name.",
      "why": "Every admin tab read \"All India Café\"; managers keep several open at once.",
      "files": [
        "app/layout.tsx",
        "app/(admin)/admin/**/page.tsx"
      ]
    },
    {
      "date": "2026-09-14",
      "choice": "error.tsx and not-found.tsx live inside the admin segment, so the shell survives.",
      "why": "notFound() was already called on both detail routes but there was no boundary, so a stale link dropped to a bare Next 404 with no nav.",
      "files": [
        "app/(admin)/admin/error.tsx",
        "app/(admin)/admin/not-found.tsx"
      ]
    }
