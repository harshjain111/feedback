{
  "name": "@aic/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Print agent for the Memory Print Module. Runs on the kiosk PC only \u2014 never deployed.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pipeline:preview": "tsx cli/preview.ts",
    "print:test": "tsx cli/print-test.ts",
    "serve": "tsx cli/serve.ts",
    "service:install": "node service/install.cjs",
    "service:uninstall": "node service/uninstall.cjs"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
