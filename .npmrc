# eslint-config-next references its plugins by bare name, and pnpm's strict
# node_modules does not expose a transitive dependency that way. Without this
# the lint step cannot load them — and `next build` PRINTS that failure and then
# exits 0 anyway, so the lint gate stops running while still looking green.
#
# The two plugins are ALSO listed as explicit devDependencies, because this
# setting only takes effect on a fresh install: pnpm will not relink an existing
# node_modules for it, not even with --force. Belt and braces, deliberately.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@next/eslint-plugin-next
